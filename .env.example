# ============ ScoutAI environment configuration (all optional) ============
# Copy this file to `.env` and fill in what you have.

# --- LLM providers (improve planning, extraction and explanations) ---
# At least one enables the LLM features; without them ScoutAI uses rule-based mode.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_MODEL=models/gemini-3.6-flash

# --- Web search (without it, the free DuckDuckGo fallback is used) ---
TAVILY_API_KEY=

# --- MongoDB (without it, results are simply not persisted) ---
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=scout_ai

# --- Agent tuning (sensible defaults) ---
MAX_ITERATIONS=2
MIN_RESULTS=8
MAX_RESULTS=10
MAX_QUERIES_PER_ROUND=4
MAX_PAGES_PER_ROUND=20
MAX_PAGES_PER_SOURCE=8
MAX_SEARCH_RESULTS=8
REQUEST_TIMEOUT=15
